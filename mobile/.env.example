# Copy to mobile/.env (ignored by git). Only EXPO_PUBLIC_* variables reach the app: never put secrets here.
# Restart `npx expo start` after changing this file.

# Backend (P1). On a physical phone use the laptop's LAN IP (macOS: `ipconfig getifaddr en0`),
# e.g. http://192.168.1.20:8000, and start uvicorn with --host 0.0.0.0. localhost works only in a simulator.
EXPO_PUBLIC_API_URL=http://localhost:8000

# true = answer API calls from src/mocks (P3 example data); false = real backend
EXPO_PUBLIC_USE_MOCKS=true

EXPO_PUBLIC_MAP_CENTER_LAT=45.7537
EXPO_PUBLIC_MAP_CENTER_LON=21.2257
