DATABASE_URL=sqlite:///./loccomun.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081
VITE_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# --- Optional (P3 AI layer; see docs/DATA.md "Stratul LLM"). Leave empty if unused. ---
# Live web search for reference projects (default on when GEMINI_API_KEY is set; false for demos/tests).
# REFERENCES_LIVE_SEARCH=false
# Fallback chain over free LLM providers, used when Gemini fails. Each key is optional.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# COHERE_API_KEY=
# NVIDIA_API_KEY=
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# ZAI_API_KEY=
# AIONLABS_API_KEY=
# GONKA_API_KEY=
# MODELSCOPE_API_KEY=
# SILICONFLOW_API_KEY=
# LLM7_API_KEY=
# KILO_API_KEY=
# LLM_ENABLED=true            # false = never call an LLM (template/fallback only)
# LLM_CHAIN=                  # override order, e.g. groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite
# LLM_ALLOW_KEYLESS=false     # true = also use providers that work without a key
# LLM_TOTAL_BUDGET_S=20
# LLM_MAX_ATTEMPTS=4
# LLM_COOLDOWN_S=300
