#!/bin/sh
# 1) block secrets  2) enforce zone ownership by branch prefix  3) run P1 tests on p1* branches.

STAGED=$(git diff --cached --name-only)

if echo "$STAGED" | grep -qE '(^|/)\.env$'; then
  echo "pre-commit: .env is staged - refusing to commit secrets"; exit 1
fi
if git diff --cached -U0 | grep -E '^\+' | grep -qE 'AIza[0-9A-Za-z_-]{30,}|sk-[A-Za-z0-9]{20,}'; then
  echo "pre-commit: staged change looks like an API key"; exit 1
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)
P1='^(CLAUDE\.md|README\.md|Makefile|\.gitignore|\.env\.example|scripts/|\.githooks/|docs/CONTRACT\.md|docs/openapi\.json|docs/ARCHITECTURE\.md|backend/__init__\.py|backend/pytest\.ini|backend/app/|backend/requirements\.txt|backend/tests/app/)'
P2='^(web/|mobile/)'
P3='^(backend/ai/|backend/impact/|backend/seed/|backend/tests/ai/|backend/tests/seed/|tests/e2e/|docs/DATA\.md)'

case "$BRANCH" in
  p1*) ZONE="$P1" ;;
  p2*) ZONE="$P2" ;;
  p3*) ZONE="$P3" ;;
  *) exit 0 ;;
esac

OUTSIDE=$(echo "$STAGED" | grep -v '^$' | grep -vE "$ZONE")
if [ -n "$OUTSIDE" ]; then
  echo "pre-commit: files outside the zone of branch '$BRANCH':"
  echo "$OUTSIDE" | sed 's/^/  /'
  exit 1
fi

case "$BRANCH" in
  p1*)
    PY=backend/.venv/Scripts/python.exe; [ -x "$PY" ] || PY=backend/.venv/bin/python
    if [ -x "$PY" ]; then
      (cd backend && "../$PY" -m pytest tests/app -q) || { echo "pre-commit: backend tests failed"; exit 1; }
    fi
    ;;
esac
exit 0
