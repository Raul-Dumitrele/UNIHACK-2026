# Copy to web/.env (ignored by git). Only VITE_* variables reach the browser: never put secrets here.

# Backend (P1). Start it with: backend/.venv/bin/python -m uvicorn backend.app.main:app --port 8000
VITE_API_URL=http://localhost:8000

# true = answer API calls from src/mocks (P3 example data) via MSW; false = real backend
VITE_USE_MOCKS=false

# Map tiles (Leaflet). OpenStreetMap standard tiles: no key, attribution required, light use only
# (https://operations.osmfoundation.org/policies/tiles/). Softened via CSS in index.css (.map-tiles).
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
VITE_MAP_CENTER_LAT=45.7537
VITE_MAP_CENTER_LON=21.2257

# Show "Marchează un teren" (POST /spaces). false = hide it.
VITE_ENABLE_MARK_PLOT=true
